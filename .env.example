# Display settings
# Set to 'pi' for fullscreen on Raspberry Pi, 'local' for windowed development
DISPLAY_MODE=local
# Canvas size in pixels (square).
CANVAS_SIZE=720
# Pixel footprint of the beam splitter cube on the screen.
# Calculate: (cube_size_mm / screen_size_mm) * CANVAS_SIZE
# e.g. for a 50mm cube on a 4-inch (~102mm) square screen at 720px: (50/102) * 720 ≈ 353
CUBE_SIZE_PX=460
# Margin in pixels inside the cube boundary. All content fits within CUBE_SIZE_PX - 2*CUBE_MARGIN.
CUBE_MARGIN=10

# Spotify API credentials
# Create an app at https://developer.spotify.com/dashboard and add
# http://localhost:8888/callback as a Redirect URI.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
