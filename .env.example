# Display settings
# Set to 'pi' for fullscreen on Raspberry Pi, 'local' for windowed development
DISPLAY_MODE=local
# Canvas size in pixels (square). Default 720 matches the Pi's 720x720 touchscreen.
CANVAS_SIZE=720

# Spotify API credentials
# Create an app at https://developer.spotify.com/dashboard and add
# http://localhost:8888/callback as a Redirect URI.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
